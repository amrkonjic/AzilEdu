@page "/animals"

<MudText Typo="Typo.h3" GutterBottom="true">Animals</MudText>
<MudText Typo="Typo.body1">
    Pregled životinja koje se nalaze u sustavu azila.
</MudText>


<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Sve životinje</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/dog.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
            <MudText Typo="Typo.body2">
                Pregled svih životinja evidentiranih u azilu.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Vrste i pasmine</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/species.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
            <MudText Typo="Typo.body2">
                Organizacija životinja prema vrstama i pasminama.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Pogledaj vrste
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Smještaj</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/house.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
           

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Pogledaj smještaj
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>
@page "/animals"
@rendermode InteractiveServer
@using AzilEdu.Shared.Models

<MudText Typo="Typo.h3" GutterBottom="true">Animals</MudText>
<MudText Typo="Typo.body1">
    Pregled životinja koje se nalaze u sustavu azila.
</MudText>


<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Sve životinje</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/dog.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
            <MudText Typo="Typo.body2">
                Pregled svih životinja evidentiranih u azilu.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Otvori pregled
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Vrste i pasmine</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/species.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
            <MudText Typo="Typo.body2">
                Organizacija životinja prema vrstama i pasminama.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Pogledaj vrste
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Smještaj</MudText>
            
            <MudPaper Class="pa-4" Elevation="2">
                <MudImage Src="images/house.jpg"
                          Alt="Pas Rex"
                          Width="250"
                          Class="mb-2" />

            </MudPaper>
            
           

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Pogledaj smještaj
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

<hr />
<hr />


<MudTable Items="@animals" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Ime</MudTh>
        <MudTh>Vrsta</MudTh>
        <MudTh>Pasmina</MudTh>
        <MudTh>Spol</MudTh>
        <MudTh>Starost</MudTh>
        <MudTh>Datum dolaska</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Ime">@context.Name</MudTd>
        <MudTd DataLabel="Vrsta">@context.Species</MudTd>
        <MudTd DataLabel="Pasmina">@context.Breed</MudTd>
        <MudTd DataLabel="Spol">@context.Gender</MudTd>
        <MudTd DataLabel="Starost">@GetAgeText(context)</MudTd>
        <MudTd DataLabel="Datum dolaska">@GetArrivalDateText(context)</MudTd>
        <MudChip T="string"
                 Color="@(context.IsAdopted ? Color.Success : Color.Warning)"
                 Variant="Variant.Filled">
            @GetAdoptionStatusText(context)
        </MudChip>
    </RowTemplate>
</MudTable>



@code {

    private string GetAgeText(Animal animal)
    {
        if (animal.Age.HasValue)
        {
            return $"{animal.Age.Value} god.";
        }
        else
        {
            return "Nepoznato";
        }
    }

    private string GetArrivalDateText(Animal animal)
    {
        if (animal.ArrivalDate.HasValue)
        {
            return animal.ArrivalDate.Value.ToShortDateString();
        }
        else
        {
            return "Nije uneseno";
        }
    }

    private string GetAdoptionStatusText(Animal animal)
    {
        return animal.IsAdopted ? "Udomljena" : "U azilu";
    }

    private List<Animal> animals = new()
    {
